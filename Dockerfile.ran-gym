# syntax=docker/dockerfile:1.7
# Standalone isolated research verification image; does not mutate the production image.
FROM python:3.13-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /workspace
COPY pyproject.toml README.md LICENSE ./
COPY agentic_ran ./agentic_ran
COPY tests ./tests
COPY configs ./configs
RUN python -m pip install --no-cache-dir ".[ran-gym,dev]"
RUN mkdir -p /workspace/results /workspace/artifacts
# Optional full ns-O-RAN simulator *inside this Docker image*.
# The native simulator is large and built only when targeting "nsoran".
# Source origins follow the official OpenRAN Gym ns-O-RAN install guide.
# Debian 11 Bullseye LTS ended 2026-08-31; its bullseye-security index
# references .deb files removed from public mirrors (apt 404, exit 100).
# Keep the application's Python 3.13 interpreter on Debian 12, but
# explicitly install Debian's Python 3.11 for the pinned legacy Waf builder.
# Waf v2.0.21 uses "pipes", which was removed from Python 3.13.
FROM python:3.13-bookworm AS nsoran
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /workspace
COPY pyproject.toml README.md LICENSE ./
COPY agentic_ran ./agentic_ran
COPY tests ./tests
COPY configs ./configs
USER root
ARG NSORAN_BUILD_JOBS=8
ARG NSORAN_E2SIM_SHA=275f58fff459975cfcaf75e5b53c338a2bb08166
ARG NSORAN_NS3_SHA=0efbfaf370350c170beb249951e5c349d7f89b34
ARG NSORAN_INTERFACE_SHA=2db7a071963a85505d8f694310844f2f4ea26ddc
RUN rm -rf /var/lib/apt/lists/* \
    && apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
       git ca-certificates build-essential g++ cmake ninja-build pkg-config \
       python3.11 python3.11-dev python3-distutils \
       libsctp-dev lksctp-tools autoconf automake libtool bison flex \
       libboost-all-dev libsqlite3-dev libgsl-dev libxml2-dev libgtk-3-dev \
    && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir ".[ran-gym,dev]" "nsoran==0.0.2"
RUN git clone https://github.com/wineslab/o-ran-e2sim.git /opt/e2sim \
    && git -C /opt/e2sim checkout --detach "${NSORAN_E2SIM_SHA}"
WORKDIR /opt/e2sim/e2sim/build
RUN cmake .. -DDEV_PKG=1 -DLOG_LEVEL=2 \
    && cmake --build . --parallel "${NSORAN_BUILD_JOBS}" \
    && cpack -G DEB \
    && dpkg -i ./e2sim-dev_1.0.0_*.deb \
    && ldconfig
RUN git clone https://github.com/wineslab/ns-o-ran-ns3-mmwave.git /opt/ns3-mmwave-oran \
    && git -C /opt/ns3-mmwave-oran checkout --detach "${NSORAN_NS3_SHA}" \
    && git clone https://github.com/o-ran-sc/sim-ns3-o-ran-e2.git /opt/ns3-mmwave-oran/contrib/oran-interface \
    && git -C /opt/ns3-mmwave-oran/contrib/oran-interface checkout --detach "${NSORAN_INTERFACE_SHA}"
WORKDIR /opt/ns3-mmwave-oran
# The pinned ns-O-RAN fork is ns-3.35-era and ships ./waf, NOT ./ns3.
# Its nsoran Python wrapper discovers scenario-one via build/optimized/build-status.py.
# Do not pass --disable-werror here: it is not registered in the pinned wscript.
# Run the legacy Waf builder with Python 3.11 explicitly. The application
# itself still uses the Python 3.13 base, pip and Gymnasium runtime.
RUN test -f ./waf \
    && /usr/bin/python3.11 -c 'import pipes' \
    && /usr/bin/python3.11 ./waf configure --enable-examples --build-profile=optimized --out=build/optimized \
    && /usr/bin/python3.11 ./waf build -j "${NSORAN_BUILD_JOBS}" \
    && test -s build/optimized/build-status.py \
    && grep -q 'scenario-one' build/optimized/build-status.py \
    && ln -s /opt/ns3-mmwave-oran /opt/ns3
WORKDIR /workspace
# Stock nsoran supports traffic steering/energy saving, not COMMAG PRB actuation.
# The build is a native ns-O-RAN Gym smoke/integration test, not a publication result.

# Opt-in CPU-only learned-controller tests: PPO, WSP, CQL, and CVaR.
FROM runtime AS final-algorithms
RUN python -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu "torch>=2.6,<3"
