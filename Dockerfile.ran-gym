# syntax=docker/dockerfile:1.7
# Standalone isolated research verification image; does not mutate the production image.
FROM python:3.13-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /workspace
COPY pyproject.toml README.md LICENSE ./
COPY agentic_ran ./agentic_ran
COPY tests ./tests
COPY configs ./configs
RUN python -m pip install --no-cache-dir ".[ran-gym,dev]"
RUN mkdir -p /workspace/results /workspace/artifacts
# Independently verified native ns-3.49 + Gymnasium implementation.
# Source is ONLY the pinned vtavakkoli/ns3-gym repo and official ns-3.49.
# Legacy wineslab/ns-o-ran and tkn-tub/ns3-gym are not runtime dependencies.
# Verified independently in https://github.com/vtavakkoli/ns3-gym/actions/runs/45200458924
FROM python:3.13-bookworm AS modern-ns3
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /workspace
COPY pyproject.toml README.md LICENSE ./
COPY agentic_ran ./agentic_ran
COPY tests ./tests
COPY configs ./configs
USER root
ARG MODERN_NS3_BUILD_JOBS=4
ARG MODERN_NS3_GYM_SHA=21e68565a6beaf13589fd19778b5332f4d0b29e0
ARG MODERN_NS3_SHA=418210e8914e9f6bcb5cddbcc94a2cecb7853b68
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates git cmake ninja-build build-essential pkg-config \
       libzmq3-dev libprotobuf-dev protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
RUN python3.13 -m pip install --no-cache-dir ".[ran-gym,dev]"
RUN git clone https://github.com/vtavakkoli/ns3-gym.git /opt/modern-ns3gym \
    && git -C /opt/modern-ns3gym checkout --detach "${MODERN_NS3_GYM_SHA}" \
    && test "$(git -C /opt/modern-ns3gym rev-parse HEAD)" = "${MODERN_NS3_GYM_SHA}"
WORKDIR /opt/modern-ns3gym
RUN bash scripts/generate-proto.sh \
    && python3.13 -m pip install --no-cache-dir .
RUN git clone --depth 1 --branch ns-3.49 \
      https://github.com/nsnam/ns-3-dev-git.git /opt/ns3 \
    && test "$(git -C /opt/ns3 rev-parse HEAD)" = "${MODERN_NS3_SHA}"
RUN cp -r cpp/contrib/vtns3gym /opt/ns3/contrib/vtns3gym \
    && cp cpp/scratch/modern-gym-loop.cc /opt/ns3/scratch/modern-gym-loop.cc
RUN cmake -S /opt/ns3 -B /opt/ns3/cmake-build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_STANDARD=23 \
      -DNS3_EXAMPLES=OFF -DNS3_TESTS=OFF -DNS3_GSL=OFF \
      "-DNS3_ENABLED_MODULES=core;network;internet;point-to-point;vtns3gym" \
    && cmake --build /opt/ns3/cmake-build \
         --target scratch_modern-gym-loop --parallel "${MODERN_NS3_BUILD_JOBS}"
RUN set -eu; \
    executable="$(find /opt/ns3 -path '*/scratch/*' -type f -executable \
      -name '*modern-gym-loop*' -print -quit)"; \
    test -n "$executable"; \
    ln -s "$executable" /usr/local/bin/vtns3gym-sim; \
    test -x /usr/local/bin/vtns3gym-sim
ENV VTNS3GYM_BINARY=/usr/local/bin/vtns3gym-sim
WORKDIR /workspace
RUN python3.13 -m pytest -q tests/test_modern_ns3_integration.py \
    && python3.13 -m agentic_ran.research_modern_ns3_container_smoke \
       --output /tmp/agentic-ran-modern-ns3-native-test.json

# Opt-in CPU-only learned-controller tests: PPO, WSP, CQL, and CVaR.
FROM runtime AS final-algorithms
RUN python -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu "torch>=2.6,<3"
